{
	"name": "pi-cc-monitor",
	"version": "0.7.0",
	"description": "Claude Code compatible Monitor for the Pi coding agent: a background watch that turns stdout lines or WebSocket frames into notifications that wake the agent.",
	"author": "tarnish233",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"extension",
		"monitor",
		"background",
		"watch",
		"claude-code"
	],
	"homepage": "https://github.com/tarnish233/pi-cc-monitor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tarnish233/pi-cc-monitor.git"
	},
	"bugs": {
		"url": "https://github.com/tarnish233/pi-cc-monitor/issues"
	},
	"files": [
		"*.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
