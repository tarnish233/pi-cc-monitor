{
	"name": "pi-cc-monitor",
	"version": "0.18.0",
	"description": "Observe files, external runner job status and WebSocket events without owning business tasks.",
	"author": "tarnish233",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"extension",
		"monitor",
		"background",
		"watch",
		"claude-code"
	],
	"homepage": "https://github.com/tarnish233/pi-cc-monitor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tarnish233/pi-cc-monitor.git"
	},
	"bugs": {
		"url": "https://github.com/tarnish233/pi-cc-monitor/issues"
	},
	"files": [
		"*.ts",
		"docs/*.md",
		"examples/*.py",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
