{
	"name": "pi-cc-monitor",
	"version": "0.1.0",
	"description": "Claude Code's Monitor tool for the Pi coding agent: a background watch that turns stdout lines or WebSocket frames into notifications that wake the agent.",
	"type": "module",
	"license": "MIT",
	"keywords": ["pi-package", "extension", "monitor", "background", "watch", "claude-code"],
	"pi": {
		"extensions": ["./index.ts"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	}
}
