		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "node scripts/typecheck.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
